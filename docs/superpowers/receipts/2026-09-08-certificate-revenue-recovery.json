    "funnelQuery": "\nSELECT period, service, device, count() AS starts,\n countIf(checkout_at >= started_at AND checkout_at < observe_until) AS checkout_flows,\n countIf(init_at >= checkout_at AND checkout_at >= started_at AND init_at < observe_until) AS payment_handoffs,\n countIf(paid_at >= init_at AND init_at >= checkout_at AND checkout_at >= started_at AND paid_at < observe_until) AS ordered_paid,\n countIf(paid_at >= started_at AND paid_at < observe_until) AS any_paid,\n countIf(failed_at >= started_at AND failed_at < observe_until) AS failed_flows\nFROM (\n SELECT *, multiIf(started_at >= toDateTime('2026-08-30 14:00:00'),'Aug31-Sep6',started_at >= toDateTime('2026-08-23 14:00:00'),'Aug24-Aug30',started_at >= toDateTime('2026-08-16 14:00:00'),'Aug17-Aug23','Aug10-Aug16') AS period,\n least(started_at + INTERVAL 24 HOUR, toDateTime('2026-09-07 14:00:00')) AS observe_until\n FROM (\n  SELECT toString(properties.flow_instance_id) AS flow,\n   minIf(timestamp,event='intake_started') AS started_at,\n   minIf(timestamp,event='checkout_viewed') AS checkout_at,\n   minIf(timestamp,event='intake_funnel_payment_initiated') AS init_at,\n   minIf(timestamp,event='purchase_completed_server') AS paid_at,\n   minIf(timestamp,event='checkout_failed') AS failed_at,\n   argMinIf(toString(properties.service_type),timestamp,event='intake_started') AS service,\n   argMinIf(toString(properties.$device_type),timestamp,event='intake_started') AS device\n  FROM events\n  WHERE timestamp >= toDateTime('2026-08-09 14:00:00') AND timestamp < toDateTime('2026-09-07 14:00:00')\n   AND event IN ('intake_started','checkout_viewed','intake_funnel_payment_initiated','purchase_completed_server','checkout_failed')\n   AND (properties.is_e2e IS NULL OR properties.is_e2e != true)\n   AND notEmpty(toString(properties.flow_instance_id))\n  GROUP BY flow\n  HAVING started_at >= toDateTime('2026-08-09 14:00:00') AND started_at < toDateTime('2026-09-06 14:00:00')\n )\n)\nGROUP BY period,service,device ORDER BY period,service,device LIMIT 100",
