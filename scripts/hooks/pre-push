#!/usr/bin/env bash
#
# Local complement to the remote PR-first ruleset.
#
# Remote protection is the authority and rejects direct main pushes. This hook
# catches the mistake before the network call and points the operator to the
# normal branch -> PR -> strict build + e2e workflow.
#
# Feature-branch pushes are not gated here; their PR owns verification.
#
set -euo pipefail

protected_ref="refs/heads/main"
pushing_to_main=false

# git feeds "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin.
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "$protected_ref" ]; then
    pushing_to_main=true
  fi
done

if [ "$pushing_to_main" = true ]; then
  echo "✗ pre-push: direct pushes to main are disabled."
  echo "  Open a PR; strict build and e2e checks must pass before merge."
  exit 1
fi

exit 0
